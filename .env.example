# Copy to .env.local and fill in. Never commit .env.local.
# Full list and purpose: context/architecture.md → Environment Variables

# Prisma (PostgreSQL)
DATABASE_URL=

# Clerk
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/login
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/admin

# Vercel Blob. Locally the read-write token (vercel_blob_rw_…) is used. On
# Vercel the connected store authenticates with OIDC + BLOB_STORE_ID.
BLOB_READ_WRITE_TOKEN=
BLOB_STORE_ID=

# prisma/seed.ts only: Clerk user ID that gets the OWNER membership
SEED_OWNER_CLERK_USER_ID=
