# Copy to .env.local and fill in. Never commit .env.local.
# Full list and purpose: context/architecture.md → Environment Variables

# Prisma (PostgreSQL)
DATABASE_URL=

# Clerk
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/login
# The login page also sets fallbackRedirectUrl="/admin" on <SignIn>, so
# this is a backup. Either way, a redirect_url back to the page someone
# opened before signing in still wins.
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/admin

# Vercel Blob. Locally the read-write token (vercel_blob_rw_…) is used. On
# Vercel the connected store authenticates with OIDC + BLOB_STORE_ID.
BLOB_READ_WRITE_TOKEN=
BLOB_STORE_ID=

# prisma/seed.ts only: Clerk user ID that gets the OWNER membership
SEED_OWNER_CLERK_USER_ID=

# Public landing page (/): which organization's latest boards it shows,
# whether the POF tab and service appear, and the site's public URL (for
# metadata, the sitemap and Open Graph links).
PUBLIC_ORG_SLUG=stereolinkz
PUBLIC_SHOW_POF=true
NEXT_PUBLIC_SITE_URL=

# Deal desk (Phase 12): team email alerts through Resend (only if approved)
# and the sender address they come from.
RESEND_API_KEY=
DEAL_ALERT_FROM=
# Team inboxes for deal alerts, comma-separated.
DEAL_ALERT_TO=
# Keys the deal form timestamps and the IP hash: 32+ random characters,
# a different value in each environment.
DEAL_SECRET=
# The private Blob store for invoices and receipts (prefix DEAL_FILES when
# connecting it in Vercel; never the public BLOB_* store).
DEAL_FILES_STORE_ID=
DEAL_FILES_READ_WRITE_TOKEN=

# Crypto deposits (Phase 13): read-only TronGrid key for the TRC20 watcher,
# and the bearer token the cron route requires (32+ random characters).
TRONGRID_API_KEY=
CRON_SECRET=

# Phase 13b. BTC deposits read an Esplora API (default Blockstream; set to
# https://mempool.space/api to switch). CoinGecko prices work without a key;
# a free demo key raises the limit. Etherscan (free) powers the ETH checker
# and the ETH balance.
BTC_API_URL=
COINGECKO_API_KEY=
ETHERSCAN_API_KEY=

# Crypto deposits (Phase 13): protects /api/cron/*, and the read-only
# blockchain data APIs used to watch our receiving addresses.
CRON_SECRET=
TRONGRID_API_KEY=
ETHERSCAN_API_KEY=
