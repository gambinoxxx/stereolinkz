// RateBoard — proposed schema v0.1 (for review, not yet migrated)
//
// Principles:
//  1. Banks and currencies are rows, never models or columns.
//  2. Rates are append-only. Editing a rate inserts a new row; "current" = newest row.
//  3. A RateBoard stores a self-contained JSON snapshot, so old boards never read live tables.
//  4. Everything tenant-owned hangs off Organization (one org in the MVP).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  // Prisma 7: the connection URL lives in prisma.config.ts
}

// ─────────────────────────────────────────────────────────────
// Tenancy & access
// ─────────────────────────────────────────────────────────────

model Organization {
  id            String  @id @default(cuid())
  name          String
  slug          String  @unique
  clerkOrgId    String? @unique // null in MVP; linked if Clerk Organizations are enabled later
  timezone      String  @default("Africa/Lagos") // dates printed on boards use this, not server UTC
  quoteCurrency String  @default("NGN")

  // Brand values templates read (copied into each board snapshot at generation time)
  logoUrl         String?
  backgroundColor String? // board background base, e.g. #2A0F58
  primaryColor    String? // buy prices and POF rate pills, e.g. #6A35D9
  accentColor     String? // sell prices, notes, logo bars, e.g. #E9B949
  contactLine     String? // WhatsApp number printed on boards
  email           String?

  // Board defaults (Settings and Templates pages)
  defaultFinePrint         String?
  defaultForexTemplateKey  String? // e.g. "forex/purple-signal"; null = first registered template
  defaultPofTemplateKey    String?
  defaultCryptoTemplateKey String?

  // Deal desk (Phase 12; Settings → Deal desk). Every service starts off:
  // the owner switches each one on after legal advice.
  dealServicesEnabled DealService[] @default([])
  dealRefPrefix       String        @default("SLZ") // references read SLZ-1047
  dealRefCounter      Int           @default(1000) // incremented in the same transaction as each insert
  contactSlaMinutes   Int           @default(15) // NEW deals not contacted after this show amber/red
  rateLockMinutes     Int           @default(30) // crypto (Phase 13)
  payoutTargetMinutes Int           @default(10) // crypto (Phase 13)
  dealDefaultOwnerId  String? // Membership that owns new deals; null = unassigned
  dealDefaultOwner    Membership?   @relation("DealDefaultOwner", fields: [dealDefaultOwnerId], references: [id], onDelete: SetNull)
  dealAlertEmails     Boolean       @default(false) // team email on new deals (only with Resend)

  memberships     Membership[]
  currencies      Currency[]
  banks           Bank[]
  coins           Coin[]
  rateBoards      RateBoard[]
  deals           Deal[]
  paymentAccounts PaymentAccount[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum MemberRole {
  OWNER
  ADMIN
  EDITOR
  VIEWER
}

// Authorization source of truth. Being signed in to Clerk is not enough;
// every server action checks for a Membership.
model Membership {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  clerkUserId    String
  role           MemberRole   @default(ADMIN)
  createdAt      DateTime     @default(now())

  defaultOwnerOf Organization[] @relation("DealDefaultOwner")
  ownedDeals     Deal[]         @relation("DealOwner")
  agreedDeals    Deal[]         @relation("DealAgreedBy")
  dealEvents     DealEvent[]

  @@unique([organizationId, clerkUserId])
  @@index([clerkUserId])
}

// ACTIVE   = managed + available to boards
// INACTIVE = managed, hidden from boards (reactivatable)
// ARCHIVED = soft-deleted; hidden everywhere, history kept
enum RecordStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

// ─────────────────────────────────────────────────────────────
// Forex
// ─────────────────────────────────────────────────────────────

model Currency {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  code      String // ISO 4217, uppercase: "USD"
  name      String // "US Dollar"
  symbol    String? // "$"
  flagCode  String? // "us", "gb", "eu" → bundled SVG flag (emoji flags render unreliably in SVG)
  sortOrder Int          @default(0)
  status    RecordStatus @default(ACTIVE)

  rates ForexRate[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organizationId, code])
  @@index([organizationId, status, sortOrder])
}

// Immutable. No updatedAt on purpose.
model ForexRate {
  id         String   @id @default(cuid())
  currencyId String
  currency   Currency @relation(fields: [currencyId], references: [id], onDelete: Restrict)

  buy  Decimal @db.Decimal(14, 4) // in Organization.quoteCurrency
  sell Decimal @db.Decimal(14, 4) // CHECK (sell >= buy) added via raw SQL in the migration

  createdById String? // Clerk user id
  createdAt   DateTime @default(now())

  @@index([currencyId, createdAt(sort: Desc)])
}

// ─────────────────────────────────────────────────────────────
// Banks & POF
// ─────────────────────────────────────────────────────────────

model Bank {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  name      String // "Wema Bank"
  shortName String? // "Wema" — what most templates print
  slug      String // normalized name, blocks "Ecobank" vs "Eco Bank" duplicates
  logoUrl   String? // Vercel Blob URL; never overwritten, a new upload = new URL
  sortOrder Int          @default(0)
  status    RecordStatus @default(ACTIVE)
  pofActive Boolean      @default(true) // show this bank's current POF rate on new POF boards

  pofRates PofRate[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organizationId, slug])
  @@index([organizationId, status, sortOrder])
}

// Immutable. One rate stream per bank (see open question on multiple offers).
model PofRate {
  id     String @id @default(cuid())
  bankId String
  bank   Bank   @relation(fields: [bankId], references: [id], onDelete: Restrict)

  rate Decimal @db.Decimal(5, 2) // percent: 3.40 means 3.4%
  note String? // "New account"

  createdById String?
  createdAt   DateTime @default(now())

  @@index([bankId, createdAt(sort: Desc)])
}

// ─────────────────────────────────────────────────────────────
// Boards & images
// ─────────────────────────────────────────────────────────────

enum RateBoardType {
  FOREX
  POF
  CRYPTO
  CUSTOM
}

// Created only when the user clicks Generate. Never updated afterwards.
model RateBoard {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  type            RateBoardType
  templateKey     String // code registry key, e.g. "forex/purple-signal"
  templateVersion Int

  snapshot        Json // everything needed to re-render; validated by Zod (board-snapshot.ts)
  snapshotVersion Int  @default(1)

  createdById String?
  createdAt   DateTime @default(now())

  images RateBoardImage[]

  @@index([organizationId, createdAt(sort: Desc)])
  @@index([organizationId, type, createdAt(sort: Desc)])
}

// Separate from RateBoard so regenerating (or a future square/feed format)
// adds an image instead of mutating the board.
model RateBoardImage {
  id          String    @id @default(cuid())
  rateBoardId String
  rateBoard   RateBoard @relation(fields: [rateBoardId], references: [id], onDelete: Cascade)

  format          String // "story" (1080×1920) for MVP
  width           Int
  height          Int
  templateKey     String
  templateVersion Int

  blobUrl      String
  blobPathname String // needed to delete the blob later
  byteSize     Int

  createdById String?
  createdAt   DateTime @default(now())

  @@index([rateBoardId, createdAt(sort: Desc)])
}

// Coins (Phase 10): rows, like currencies and banks. Rates are naira per
// $1 of coin value, one buy and one sell per coin.
model Coin {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  ticker     String // "BTC": ^[A-Z0-9]{2,6}$, unique per org; fixed once added
  name       String // "Bitcoin", ≤ 20 characters
  networks   String[] // ["TRC20", "BEP20"]: display only, ≤ 4 stored, boards show 2
  iconUrl    String? // Vercel Blob URL; never overwritten, a new upload = new URL
  badgeColor String? // #RRGGBB behind the letter badge when there is no icon
  sortOrder  Int          @default(0)
  status     RecordStatus @default(ACTIVE)

  rates CryptoRate[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organizationId, ticker])
  @@index([organizationId, status, sortOrder])
}

model CryptoRate {
  id     String @id @default(cuid())
  coinId String
  coin   Coin   @relation(fields: [coinId], references: [id], onDelete: Restrict)

  buy  Decimal @db.Decimal(14, 4) // naira per $1 of coin value
  sell Decimal @db.Decimal(14, 4) // CHECK (sell >= buy) added via raw SQL in the migration

  createdById String? // Clerk user id
  createdAt   DateTime @default(now())

  @@index([coinId, createdAt(sort: Desc)])
}

// ─────────────────────────────────────────────────────────────
// Deal desk (Phase 12; crypto in Phase 13)
// ─────────────────────────────────────────────────────────────

enum DealService {
  SCHOOL_FEES
  INTL_PAYMENT
  POF
  FOREX_SELL
  FOREX_BUY
  CRYPTO_SELL // Phase 13
}

// Non-crypto: NEW → AGREED → AWAITING_PAYMENT → PAYMENT_RECEIVED →
// PROCESSING → COMPLETED, or CANCELLED. The crypto statuses are used from
// Phase 13. Every change goes through transitionDeal (features/deals).
enum DealStatus {
  NEW
  AGREED
  AWAITING_PAYMENT
  PAYMENT_RECEIVED
  PROCESSING
  COMPLETED
  CANCELLED
  AWAITING_DEPOSIT // Phase 13
  DEPOSIT_SEEN // Phase 13
  DEPOSIT_COMPLETE // Phase 13
  PAID_OUT // Phase 13
  EXPIRED // Phase 13
  FLAGGED // Phase 13
}

enum DealActor {
  MEMBER
  CUSTOMER
  SYSTEM
}

enum DealEventType {
  REQUESTED // the deal was created (website or team)
  STATUS_CHANGED // fromStatus → toStatus, through transitionDeal
  RATE_AGREED // agreed rate, fee and naira recorded
  RATE_CHANGED // agreed values changed (with a reason once payment details were shared)
  PAYMENT_DETAILS_SHARED // the account shown to the customer
  CUSTOMER_PAID // the customer tapped "I’ve paid"
  FILE_UPLOADED
  OWNER_CHANGED
  NOTE // internal, team only
  ALERT_SENT
}

enum DealFileKind {
  INVOICE
  RECEIPT
  CONFIRMATION
  OTHER
}

model Deal {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  ref     String // "SLZ-1047", unique per org, from Organization.dealRefCounter
  service DealService
  status  DealStatus  @default(NEW)

  customerName     String
  customerWhatsapp String // normalised with normalizeWhatsAppNumber
  customerEmail    String?

  details        Json // validated by dealDetailsV1 (features/deals/schema.ts)
  detailsVersion Int  @default(1)

  currency String // ISO code of the amount, or NGN for POF
  amount   Decimal @db.Decimal(18, 4) // CHECK (amount > 0) in the migration

  // The website estimate, from the latest board snapshot at request time.
  // Never changes after insert (trigger in the migration). Null when the
  // board had no rate for the currency or bank: "We’ll quote on WhatsApp".
  quotedRate    Decimal?  @db.Decimal(18, 4) // naira per unit; POF: % per month
  quotedNaira   Decimal?  @db.Decimal(24, 8) // stored exactly; shown in whole naira
  quotedBoardId String?
  quotedAt      DateTime?

  // Agreed on WhatsApp and recorded by the team.
  agreedRate  Decimal?    @db.Decimal(18, 4)
  feeNaira    Decimal?    @db.Decimal(24, 8)
  agreedNaira Decimal?    @db.Decimal(24, 8)
  agreedAt    DateTime?
  agreedById  String?
  agreedBy    Membership? @relation("DealAgreedBy", fields: [agreedById], references: [id], onDelete: SetNull)

  // Our account the customer pays into (shown only from AWAITING_PAYMENT).
  paymentAccountId String?
  paymentAccount   PaymentAccount? @relation("DealPaymentAccount", fields: [paymentAccountId], references: [id], onDelete: Restrict)

  // Where we pay the customer (FOREX_SELL; crypto in Phase 13).
  payoutBank          String?
  payoutAccountNumber String?
  payoutAccountName   String?
  payoutReference     String?
  paidFromAccountId   String?
  paidFromAccount     PaymentAccount? @relation("DealPaidFrom", fields: [paidFromAccountId], references: [id], onDelete: Restrict)

  ownerMembershipId String?
  owner             Membership? @relation("DealOwner", fields: [ownerMembershipId], references: [id], onDelete: SetNull)
  cancelReason      String?

  trackingTokenHash String // SHA-256 of the customer's link token; the token itself is never stored
  ipHash            String? // keyed hash of the submitting IP, for the rate limit only

  statusChangedAt DateTime @default(now())
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  events DealEvent[]
  files  DealFile[]

  @@unique([organizationId, ref])
  @@index([organizationId, status, statusChangedAt])
  @@index([organizationId, createdAt])
  @@index([organizationId, customerWhatsapp])
  @@index([ipHash, createdAt])
}

// Append-only (a trigger in the migration refuses UPDATE). No updatedAt.
model DealEvent {
  id     String @id @default(cuid())
  dealId String
  deal   Deal   @relation(fields: [dealId], references: [id], onDelete: Cascade)

  type       DealEventType
  fromStatus DealStatus?
  toStatus   DealStatus?
  message    String
  data       Json?

  actorType         DealActor
  actorMembershipId String?
  actorMembership   Membership? @relation(fields: [actorMembershipId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([dealId, createdAt])
}

// Private uploads: random pathnames, served only through
// /api/deals/[ref]/files/[id]. The blob URL never reaches a browser.
model DealFile {
  id     String @id @default(cuid())
  dealId String
  deal   Deal   @relation(fields: [dealId], references: [id], onDelete: Cascade)

  kind         DealFileKind
  blobUrl      String // server-only
  blobPathname String // deals/{orgId}/{dealId}/{random}.{ext}
  contentType  String
  byteSize     Int
  originalName String
  uploadedBy   DealActor // CUSTOMER or MEMBER

  createdAt DateTime @default(now())

  @@index([dealId, createdAt])
}

// Our accounts, and the services each may be shown for.
model PaymentAccount {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  bank          String
  accountNumber String
  accountName   String
  currency      String        @default("NGN")
  services      DealService[] @default([])
  active        Boolean       @default(true)
  sortOrder     Int           @default(0)

  shownOnDeals Deal[] @relation("DealPaymentAccount")
  paidFrom     Deal[] @relation("DealPaidFrom")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId, active, sortOrder])
}
